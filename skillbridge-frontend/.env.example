VITE_API_URL=http://127.0.0.1:8000
# Public OAuth client ID only; needed for real Google sign-in.
VITE_GOOGLE_CLIENT_ID=

# Optional private Broadcast pilot. False preserves the existing SSE transport.
# Backend eligibility/configuration must also opt in; no signing/server keys here.
VITE_SUPABASE_REALTIME_PILOT=false
