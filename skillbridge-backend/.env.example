# Optional public company branding Storage integration. Backend only.
# This is the HTTPS project API origin, not the PostgreSQL/pooler hostname.
SUPABASE_STORAGE_URL=https://your-project-ref.supabase.co
# Supply the project's legacy service_role key through backend secrets management.
# Never put this key in VITE_* variables or commit a populated .env file.
SUPABASE_STORAGE_SERVICE_KEY=
COMPANY_IMAGE_BUCKET=company-branding

# See knowledge/LOCAL_SETUP_AND_OPERATIONS.md from the repository root.
# Image-free company CRUD does not require Storage configuration.

# PostgreSQL connection timeout in seconds per resolved server address.
# Prevents runserver's migration check from waiting indefinitely on a connection.
DB_CONNECT_TIMEOUT=5

# Local development only. Copy into .env only in a fresh checkout;
# preserve an existing .env and never commit populated credentials.
SECRET_KEY=replace-with-a-new-random-local-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173
DB_NAME=skillbridge_local
DB_USER=skillbridge_local
DB_PASSWORD=replace-with-local-database-password
DB_HOST=127.0.0.1
DB_PORT=5432

# External email is disabled unless configured explicitly.
BREVO_API_KEY=
ENROLLMENT_SMTP_FALLBACK=False
EMAIL_TIMEOUT=5

# Private evidence only; never use the public company-branding bucket.
# Reuses backend-only SUPABASE_STORAGE_URL and SUPABASE_STORAGE_SERVICE_KEY.
RETAKE_EVIDENCE_BUCKET=retake-evidence
