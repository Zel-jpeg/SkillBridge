# Optional public company branding Storage integration. Backend only.
# This is the HTTPS project API origin, not the PostgreSQL/pooler hostname.
SUPABASE_STORAGE_URL=https://your-project-ref.supabase.co
# Supply the project's legacy service_role key through backend secrets management.
# Never put this key in VITE_* variables or commit a populated .env file.
SUPABASE_STORAGE_SERVICE_KEY=
COMPANY_IMAGE_BUCKET=company-branding

# Existing Django/database settings are described in SKILLBRIDGE_CONTEXT.md.
# Image-free company CRUD does not require Storage configuration.
